# ===== 北极星 NorthStar 配置模板 =====
# 复制为 .env 并填入真实值即可激活对应能力。不填则优雅降级到种子数据。

# ---- 飞书开放平台（知识库 / 脚本库 / 直播复盘 直连）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 三个核心文档（默认已指向 caocp410jp 账号的文档）
FEISHU_SCRIPT_DOC=https://caocp410jp.feishu.cn/docx/WoKwdMyBYoIQpqxQH32cUVqmnic
FEISHU_LIVE_SUMMARY_DOC=https://caocp410jp.feishu.cn/docx/E6Vsd31qDoO9VXxAyQWcbFH8n4b
FEISHU_LIVE_SCRIPT_DOC=https://caocp410jp.feishu.cn/docx/OqMDd8DI0ouQdwxv5WlcWzqOnNg

# ---- 混元大模型（Cue 问答 / 三句结论 / 拆脚本）----
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-turbos-latest

# ---- 登录 / 会话 ----
# 未设则用随机密钥（重启后已登录用户需重新登录）
JWT_SECRET=
SESSION_TTL_DAYS=7

# ---- 视频号后台抓取器 ----
SCRAPER_HEADLESS=1
SCRAPER_LOGIN_TTL_DAYS=7
